NEXT_PUBLIC_CAS_DATA_SOURCE=demo
NEXT_PUBLIC_CAS_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-local-or-remote-db-password
NEXT_PUBLIC_APP_URL=http://localhost:3000
CAS_EMAIL_PROVIDER=development-log
CAS_EMAIL_FROM=CAS <notifications@example.com>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=

# Development-only authenticated Supabase smoke users.
# Use ignored .env.local values. Never commit real passwords.
CAS_STAGE_TEST_PASSWORD=replace-with-local-development-password
CAS_STAGE_COMPANY_ADMIN_EMAIL=cas-stage-company-admin@example.com
CAS_STAGE_COMPANY_ADMIN_PASSWORD=
CAS_STAGE_OFFICE_STAFF_EMAIL=cas-stage-office-staff@example.com
CAS_STAGE_OFFICE_STAFF_PASSWORD=
CAS_STAGE_APPRAISER_EMAIL=cas-stage-appraiser@example.com
CAS_STAGE_APPRAISER_PASSWORD=
CAS_STAGE_REVIEWER_EMAIL=cas-stage-reviewer@example.com
CAS_STAGE_REVIEWER_PASSWORD=
CAS_STAGE_AMC_ADMIN_EMAIL=cas-stage-amc-admin@example.com
CAS_STAGE_AMC_ADMIN_PASSWORD=
CAS_STAGE_CLIENT_USER_EMAIL=cas-stage-client@example.com
CAS_STAGE_CLIENT_USER_PASSWORD=
